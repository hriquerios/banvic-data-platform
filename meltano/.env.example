# -----------------------------------------------------------------------------
# Execução LOCAL do Meltano (fora do Kubernetes), útil para desenvolvimento.
# Copie para meltano/.env e preencha. O arquivo .env está no .gitignore.
# No Kubernetes estes valores vêm do Secret "banvic-loader-credentials".
# -----------------------------------------------------------------------------
BANVIC_SOURCE_DIR=../data/banvic_erp

TARGET_POSTGRES_HOST=localhost
TARGET_POSTGRES_PORT=15432
TARGET_POSTGRES_DATABASE=banvic
TARGET_POSTGRES_USER=banvic_loader
TARGET_POSTGRES_PASSWORD=<preencha>
